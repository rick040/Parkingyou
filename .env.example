# ParkingYou website environment variables.
#
# Copy to .env.local and fill in. NEVER commit real values: the Aeroparker API
# key appears in the query string of every booking URL and is a credential.

# Aeroparker booking deep links.
# The base the booking URL is built on, without a trailing slash. The site code
# is appended from the location's own `aeroparker.site`, so this is the part
# before it, for example https://api.aeroparker.com/book
AEROPARKER_BOOKING_BASIS=

# The API key Aeroparker issues. Server-side only: the browser receives a
# finished URL from /api/boekingslink and never this value.
AEROPARKER_API_KEY=

# Map tiles. Defaults to the PDOK BRT Achtergrondkaart, which needs no key.
# Override only to point a preview at a different tile source.
# NEXT_PUBLIC_KAART_TEGELS=
